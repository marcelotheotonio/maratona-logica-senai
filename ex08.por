programa {
  funcao inicio() {
    
//Conversão de temperatura para Farenheit

real celsius , temperatura

escreva("Digite a temperatura informada pelo sensor do forno: \n")
leia(celsius)

temperatura = (celsius*1.8) + 32

escreva("A temperatura informada, convertida em Farenheit é: " , temperatura)
escreva("\n")

  }
}
