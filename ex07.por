programa {
  funcao inicio() {
    

real precoCusto, precoVenda
    
        escreva("Informe o preço de custo da engrenagem: R$ ")
        leia(precoCusto)

        precoVenda = (precoCusto + (precoCusto * 0.15))

        escreva("Preço de venda com 15% de lucro: R$ ", precoVenda)
        escreva("\n")

  }
}
