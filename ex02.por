programa {
  funcao inicio() {

    
inteiro remessa1, remessa2, total

   escreva("Informe a quantidade da primeira remessa: ")
   leia(remessa1)

   escreva("Informe a quantidade da segunda remessa: ")
   leia(remessa2)

   total = (remessa1 + remessa2)

   escreva("O estoque total disponível é: ", total)
   escreva("\n")
    
  }
}
