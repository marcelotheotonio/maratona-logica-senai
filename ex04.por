programa {
  funcao inicio() {

    //Precisão de Peças:

      real metros
      real milimetros

        escreva("Digite a medida em metros: ")
        leia(metros)

        // Conversão: 1 metro = 1000 milímetros

        milimetros = (metros * 1000)

        escreva("Valor em milímetros: ", milimetros)
        escreva("\n")







    
  }
}
