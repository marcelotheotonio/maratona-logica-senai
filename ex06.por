programa {
  funcao inicio() {
    
//Espaço de Armazenagem


   real largura, comprimento, area
              
        escreva("Informe a largura do galpão (em metros): ")
        leia(largura)

        escreva("Informe o comprimento do galpão (em metros): ")
        leia(comprimento)
      
        area = (largura * comprimento)

escreva("A metragem total, em metros quadrados, é: ", area)
escreva("\n")


  }
}
