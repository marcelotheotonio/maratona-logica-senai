programa {
  funcao inicio() {
    
//IDRastreabilidade

   inteiro id, anterior, posterior

   escreva("Digite o ID da peca: ")
   leia(id)

   anterior = (id - 1)
   posterior = (id + 1)

   escreva("ID anterior: ", anterior)
   escreva("\n")
   escreva("ID posterior: ", posterior)
   escreva("\n")

  }
}
